# Copy to .env and fill in.  offline = no API needed (demo quality); gemini = real models
PROVIDER=gemini
GEMINI_API_KEY=            # from https://aistudio.google.com/apikey  (or use GOOGLE_CLOUD_PROJECT for Vertex AI)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
JWT_SECRET=                # at least 32 random characters:  openssl rand -hex 32
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
PRICE_IN_PER_M=0           # USD per 1M input tokens, from Google's current price list
PRICE_OUT_PER_M=0
DOCS_ROOT=sample_data/docs
